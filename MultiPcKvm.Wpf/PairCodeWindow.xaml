<Window x:Class="MultiPcKvm.Wpf.PairCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="연결 코드 입력"
        Height="250" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Border Background="White" CornerRadius="8" Margin="14"
            BorderBrush="#E3E5E9" BorderThickness="1" Padding="20,18">
        <StackPanel>

            <TextBlock x:Name="TargetText" Text="..."
                       FontSize="15" FontWeight="SemiBold" />

            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       FontSize="11" Foreground="#9098A5"
                       Text="상대 PC 화면에 표시된 4자리 코드를 입력하세요." />

            <!-- 숫자 4자리만 받는다. 가운데 정렬에 큼직하게. -->
            <TextBox x:Name="CodeBox"
                     MaxLength="4"
                     FontSize="30"
                     FontFamily="Consolas"
                     TextAlignment="Center"
                     Padding="0,8"
                     Margin="0,16,0,0"
                     PreviewTextInput="CodeBox_PreviewTextInput"
                     KeyDown="CodeBox_KeyDown" />

            <TextBlock x:Name="ErrorText" Text=""
                       Foreground="#DC2626" FontSize="11"
                       Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="취소" Width="70" Padding="0,6"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="연결" Width="70" Padding="0,6"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
