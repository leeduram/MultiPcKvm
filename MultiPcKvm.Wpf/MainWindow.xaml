<Window x:Class="MultiPcKvm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiPcKvm" Height="800" Width="520"
        ResizeMode="CanMinimize"
        Background="#F5F6F8"
        Closing="Window_Closing">

    <!--
        화면 구성

        모양은 여기(XAML), 동작은 MainWindow.xaml.cs 에 있다. 둘이 짝이다.
        x:Name 이 붙은 것들은 .cs 에서 이름으로 찾아 쓸 수 있다.
    -->

    <Window.Resources>

        <!-- 카드 한 장의 모양. 흰 배경에 둥근 모서리. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#E3E5E9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 구역 제목 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!-- 흐린 설명 글씨 -->
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9098A5" />
        </Style>

        <!-- true / false 를 보임 / 숨김 으로 바꿔준다.
             [삭제] 버튼을 저장된 기기에서만 보여줄 때 쓴다. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </Window.Resources>


    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- ═══ 내 PC ═══════════════════════════════════════ -->

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="내 PC" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="MyNameText" Text="..."
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="MyInfoText" Text="..."
                               Style="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 연결 코드.
                     상대가 이 PC 를 조종하려면 이 숫자를 입력해야 한다. -->
                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6"
                        Padding="14,8" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="연결 코드" FontSize="10"
                                   Foreground="#6366F1" HorizontalAlignment="Center" />
                        <TextBlock x:Name="MyCodeText" Text="----"
                                   FontSize="24" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="#4F46E5"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <!-- ═══ 기기 목록 제목 ═══════════════════════════════ -->

        <!-- 오른쪽 끝 [연결 기록] 버튼: 누르면 연결 기록 창(ConnectionHistoryWindow)이 새 창으로 뜬다. (8주차) -->
        <Grid Grid.Row="1" Margin="2,4,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="주변 기기" Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" Margin="0" />
            <TextBlock x:Name="SearchingText" Grid.Column="1" Text="검색 중..."
                       Style="{StaticResource Dim}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="연결 기록" Padding="10,2" Margin="10,0,0,0"
                    FontSize="11" VerticalAlignment="Center"
                    ToolTip="지금까지의 연결 기록을 검색하고 페이지로 넘겨 봅니다"
                    Click="HistoryButton_Click" />
        </Grid>


        <!-- ═══ 기기 목록 ═══════════════════════════════════ -->

        <Grid Grid.Row="2">

            <!-- 아무것도 못 찾았을 때 보여줄 안내 -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Card}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="주변에 기기가 없습니다"
                               FontSize="13" Foreground="#6B7280" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="상대 PC 에서도 이 프로그램을 실행하세요. 두 PC 가 같은 공유기에 연결되어 있어야 합니다." />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 연결 표시등
                                         회색 = 꺼져 있음(저장된 기기)
                                         파랑 = 켜져 있음(검색됨)
                                         초록 = 내가 조종 중

                                         트리거는 아래에 있는 것이 이긴다.
                                         그래서 가장 중요한 "조종 중" 을 맨 아래에 둔다. -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#C9CDD4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#60A5FA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- 마우스를 올리면 연결 통계(연결 횟수·마지막 연결·평균 지연)를 보여준다. (6주차) -->
                                    <!-- 이름을 더블클릭하면 기기 상세 창이 열린다. (10주차, MainWindow.DeviceDetail.cs)
                                         Background="Transparent" : 글자 사이 빈 곳을 눌러도 잡히게 -->
                                    <StackPanel Grid.Column="1" ToolTip="{Binding DetailText}"
                                                Background="Transparent"
                                                MouseLeftButtonDown="DeviceName_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource Dim}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- 화면 배치. 저장된 기기에만 보인다.
                                         (배치는 저장된 기기마다 DB 에 저장되기 때문)
                                         연결 중에도 누를 수 있고, 저장하면 바로 적용된다. -->
                                    <Button Grid.Column="2"
                                            Content="배치"
                                            ToolTip="상대 PC 화면이 내 화면 어느 쪽에 있는지 정합니다"
                                            Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}"
                                            Click="LayoutButton_Click"
                                            Padding="8,5" Margin="0,0,6,0"
                                            Background="Transparent" BorderBrush="#E3E5E9"
                                            Foreground="#4B5563" FontSize="11"
                                            VerticalAlignment="Center" />

                                    <!-- 저장된 기기 삭제. 저장된 기기에만 보인다. -->
                                    <Button Grid.Column="3"
                                            Content="삭제"
                                            ToolTip="저장된 기기 목록에서 삭제합니다"
                                            Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}"
                                            Click="DeleteDevice_Click"
                                            Padding="8,5" Margin="0,0,6,0"
                                            Background="Transparent" BorderBrush="#E3E5E9"
                                            Foreground="#9098A5" FontSize="11"
                                            VerticalAlignment="Center" />

                                    <!-- 상대 화면 보기. 내가 이 기기를 조종 중일 때만 보인다. (MainWindow.ScreenView.cs) -->
                                    <Button Grid.Column="4"
                                            Content="화면"
                                            ToolTip="상대 PC 화면을 보면서 조종합니다"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}"
                                            Click="ViewScreen_Click"
                                            Padding="8,5" Margin="0,0,6,0"
                                            Background="Transparent" BorderBrush="#E3E5E9"
                                            Foreground="#4B5563" FontSize="11"
                                            VerticalAlignment="Center" />

                                    <!-- 파일 보내기·받기. 내가 이 기기를 조종 중일 때만 보인다.
                                         누르면 [파일 보내기] [파일 받기] 메뉴가 뜬다. (MainWindow.FileTransfer.cs)
                                         화면 보기 창을 열지 않아도 쓸 수 있다. -->
                                    <Button Grid.Column="5"
                                            Content="파일"
                                            ToolTip="상대 PC 와 파일을 주고받습니다 (보내기 · 받기)"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}"
                                            Click="FileMenu_Click"
                                            Padding="8,5" Margin="0,0,6,0"
                                            Background="Transparent" BorderBrush="#E3E5E9"
                                            Foreground="#4B5563" FontSize="11"
                                            VerticalAlignment="Center" />

                                    <Button Grid.Column="6"
                                            Content="{Binding ActionText}"
                                            IsEnabled="{Binding CanAct}"
                                            Tag="{Binding}"
                                            Click="DeviceAction_Click"
                                            Padding="14,5" MinWidth="74"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>


        <!-- ═══ 안내 / 상태 ═════════════════════════════════ -->

        <!-- ═══ 설정 ═══════════════════════════════════════════
             Click 으로 받는다. (Checked 는 코드에서 값을 넣을 때도 불려서 저장이 되풀이된다) -->

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="설정" Style="{StaticResource SectionTitle}" />

                <CheckBox x:Name="AutoStartBox"
                          Content="Windows 시작 시 자동 실행"
                          Click="AutoStartBox_Click"
                          Margin="0,2,0,0" />

                <!-- 자동 실행이 꺼져 있으면 의미가 없어서 잠긴다. (코드에서 IsEnabled 를 바꾼다) -->
                <CheckBox x:Name="StartHiddenBox"
                          Content="자동 실행될 때 창을 띄우지 않고 트레이에 숨긴 채로 시작"
                          Click="StartHiddenBox_Click"
                          IsEnabled="False"
                          Margin="18,6,0,0" />

                <CheckBox x:Name="CloseToTrayBox"
                          Content="창을 닫아도 종료하지 않고 트레이로 숨기기"
                          Click="CloseToTrayBox_Click"
                          Margin="0,6,0,0" />

                <!-- 관리자 권한
                     상대 PC 의 관리자 창(작업 관리자 등)까지 조작하려면 필요하다. (Elevation.cs 설명) -->
                <CheckBox x:Name="RunAsAdminBox"
                          Content="관리자 권한으로 실행 (켤 때 Windows 확인 창)"
                          Click="RunAsAdminBox_Click"
                          Margin="0,6,0,0" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="AdminStateText" Style="{StaticResource Dim}"
                               VerticalAlignment="Center" Text="..." />

                    <Button x:Name="RestartAdminButton" Grid.Column="1"
                            Content="관리자 권한으로 다시 시작"
                            Click="RestartAdminButton_Click"
                            Padding="10,4" Margin="8,0,0,0" FontSize="11" />
                </Grid>

                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="트레이 아이콘: 왼쪽 클릭 = 창 열기, 오른쪽 클릭 = 종료" />
            </StackPanel>
        </Border>


        <!-- ═══ 안내 / 상태 (아래) ═════════════════════════════ -->

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>

                <!-- 서로 조종 체크박스는 뺐다.
                     한쪽이 조종하는 동안 반대쪽은 연결할 수 없다. (한 방향만) -->

                <!-- 방화벽 상태 + [방화벽 허용] 버튼
                     버튼은 "규칙 없음" 이나 "차단" 일 때만 누를 수 있다. (코드: CheckFirewallAsync)
                     처음에는 확인이 끝나기 전이라 잠가 둔다. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FirewallText"
                               Style="{StaticResource Dim}"
                               Text="방화벽: 확인 중..."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button x:Name="FirewallButton" Grid.Column="1"
                            Content="방화벽 허용"
                            IsEnabled="False"
                            Click="FirewallButton_Click"
                            Padding="10,4" Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>

                <Separator Margin="0,0,0,8" />

                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Style="{StaticResource Dim}"
                           Text="연결할 기기의 [연결] 을 누르세요." />

            </StackPanel>
        </Border>

    </Grid>
</Window>
