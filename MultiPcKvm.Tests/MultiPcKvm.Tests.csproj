<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 저장소(DB) 검사 프로그램. (6주차)
         VS 에서 이 프로젝트를 [시작 프로젝트로 설정] → 실행(Ctrl+F5) 하면 검사가 돌고 결과가 콘솔에 나온다.
         실제 DB(%AppData%\MultiPcKvm\kvm.db)는 건드리지 않는다. 임시 폴더에 시험용 DB 를 만들고 끝나면 지운다.
         배포(exe) 에는 들어가지 않는다. WPF 가 이 프로젝트를 참조하지 않기 때문이다. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiPcKvm.App\MultiPcKvm.App.csproj" />
  </ItemGroup>

</Project>
